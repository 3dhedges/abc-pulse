# ABC Pulse configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is gitignored. Never commit real keys.
#
# Every value is optional for a first run. The app starts without them and
# serves fallback (flag-off) experiences until LaunchDarkly is configured.

# --- LaunchDarkly: SDK credentials -------------------------------------------
# LD SETUP: In LaunchDarkly, open Project settings > Environments, choose your
# environment (e.g. "Test"), and copy its keys from the "..." menu.

# Server-side SDK key (starts with "sdk-"). Used by the Python server SDK.
# Keep it secret; it must never reach the browser.
LD_SDK_KEY=

# Client-side ID. Used by the JavaScript SDK in the browser and safe to expose.
# LD SETUP: In the flag settings, enable "SDKs using Client-side ID" for each flag
# the browser evaluates, or the browser SDK won't see it.
LD_CLIENT_SIDE_ID=

# --- LaunchDarkly: REST API (setup automation & scripts) ---------------------
# LD SETUP: Create an API access token under Organization settings >
# Authorization, with the Writer role. Used only by scripts/setup_launchdarkly.py.
LD_API_TOKEN=

# Project and environment keys shown in Project settings (e.g. "abc-pulse", "test").
LD_PROJECT_KEY=abc-pulse
LD_ENVIRONMENT_KEY=test

# --- LaunchDarkly: remediation trigger ---------------------------------------
# LD SETUP: Open the "account-health-panel" flag, go to Settings > Triggers, and
# add a "Generic trigger" with the action "Turn the flag off". Paste the
# generated URL here. Treat it as a secret: anyone with the URL can flip the flag.
# Used by scripts/kill-switch.sh and scripts/watchdog.py.
LD_TRIGGER_URL=

# --- AI assistant (optional) -------------------------------------------------
# API key for the LLM provider used by the account assistant. If left blank,
# the app uses a built-in mock provider that returns canned summaries.
LLM_API_KEY=

# --- Web server --------------------------------------------------------------
# Port for the local web server. On macOS, AirPlay Receiver can take 5000;
# if so, use 5050.
PORT=5000
